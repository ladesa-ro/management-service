# ENABLE_MOCK_ACCESS_TOKEN=true
# Path dentro do container para armazenamento de arquivos enviados
STORAGE_PATH=/container/uploaded

#

TYPEORM_LOGGING=true
DB_CONNECTION=postgres
DATABASE_URL=postgresql://postgres:7f22682363b549a389e03b7fe512488b@ladesa-management-service-db:5432/main
DATABASE_USE_SSL=false

#

OAUTH2_CLIENT_PROVIDER_OIDC_ISSUER=https://sso.ladesa.com.br/realms/sisgea-playground
OAUTH2_CLIENT_REGISTRATION_LOGIN_CLIENT_ID=luna-backend
OAUTH2_CLIENT_REGISTRATION_LOGIN_CLIENT_SECRET=8c9jOX4v0J9k0nwfdWQRpoGlNDcsSprf
OAUTH2_CLIENT_REGISTRATION_LOGIN_SCOPE=openid profile

KC_BASE_URL=https://sso.ladesa.com.br
KC_REALM=sisgea-playground
KC_CLIENT_ID=luna-backend
KC_CLIENT_SECRET=8c9jOX4v0J9k0nwfdWQRpoGlNDcsSprf
KC_PASSWORD_RESET_REDIRECT_URI=https://dev.ladesa.com.br

#

MESSAGE_BROKER_URL=amqp://admin:admin@ladesa-rabbitmq
MESSAGE_BROKER_QUEUE_TIMETABLE_REQUEST=dev.timetable_generate.request
MESSAGE_BROKER_QUEUE_TIMETABLE_RESPONSE=dev.timetable_generate.response

# WAHA (WhatsApp HTTP API)
# URL base do container WAHA (dentro da rede Docker)
WAHA_BASE_URL=http://ladesa-waha-service:3000
# Chave de API para autenticação (usada no header X-Api-Key ao chamar a API do WAHA)
WAHA_API_KEY=dev.WAHA_API_KEY
# Timeout das requisições ao WAHA (em milissegundos)
WAHA_TIMEOUT=10000
# Nome da sessão WhatsApp no WAHA (padrão: "default")
WAHA_SESSION=default
# URL do webhook para onde o WAHA enviará eventos (sem token na URL — auth via HMAC)
WAHA_WEBHOOK_URL=http://ladesa-management-service:3701/api/webhooks/whatsapp
# Chave HMAC para autenticação dos webhooks recebidos do WAHA.
# O WAHA assina o payload com HMAC-SHA512 e envia no header X-Webhook-Hmac.
# O backend valida a assinatura com timing-safe compare para prevenir timing attacks.
# Gerar valor seguro em prod: openssl rand -hex 32
WAHA_WEBHOOK_HMAC_KEY=dev.WAHA_WEBHOOK_HMAC_KEY
# Credenciais do dashboard/Swagger UI do WAHA (basic auth)
WAHA_USERNAME=dev.WAHA_USERNAME
WAHA_PASSWORD=dev.WAHA_PASSWORD